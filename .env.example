# Copia a .env para probar en local (pnpm dev). Nunca subas .env al repo.
# En producción van en Cloudflare Pages → personal-website → Settings → Variables and Secrets (tipo Secret).

# Formulario de contacto (Resend)
NUXT_RESEND_API_KEY=
NUXT_CONTACT_EMAIL=

# Nuxt Studio: OAuth App de GitHub (https://github.com/settings/developers)
# Callback en producción: https://www.joangarfias.me/__nuxt_studio/auth/github
# En local (pnpm dev) Studio edita los archivos directamente y no necesita estas variables
NUXT_STUDIO_AUTH_GITHUB_CLIENT_ID=
NUXT_STUDIO_AUTH_GITHUB_CLIENT_SECRET=
# Correos de GitHub que pueden entrar a Studio, separados por coma (recomendado)
NUXT_STUDIO_AUTH_GITHUB_MODERATORS=
# Clave para cifrar la sesión de Studio: 32+ caracteres aleatorios (openssl rand -hex 32)
NUXT_STUDIO_AUTH_SESSION_SECRET=
